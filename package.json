{
  "name": "macbello-desktop",
  "version": "1.0.0",
  "description": "Macbello Salon - Desktop Billing & POS",
  "main": "dist/main/index.js",
  "author": "Macbello",
  "license": "UNLICENSED",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"VITE,ELECTRON\" -c \"cyan.bold,yellow.bold\" \"vite\" \"wait-on tcp:5173 && npm run electron:dev\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "electron:dev": "tsc -p tsconfig.main.json && cross-env NODE_ENV=development electron .",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run clean && npm run build:main && npm run build:renderer",
    "start": "cross-env NODE_ENV=production electron .",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "postcss": "^8.5.32",
    "rimraf": "^6.1.4",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "wait-on": "^9.5.1"
  }
}
